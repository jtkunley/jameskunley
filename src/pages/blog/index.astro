---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout
	title="Writing"
	description="Technical writing on software engineering, systems design, and tooling."
>
	<div class="container container--narrow">
		<header class="page-header">
			<p class="eyebrow">Blog</p>
			<h1>Writing</h1>
			<p>Notes on software engineering, systems design, and the lessons learned along the way.</p>
			<p class="feed"><a href="/rss.xml">Subscribe via RSS</a></p>
		</header>
		{posts.length > 0 ? <PostList posts={posts} /> : <p>No posts yet. Check back soon.</p>}
	</div>
</BaseLayout>

<style>
	.page-header .feed {
		font-size: var(--step--1);
		margin: 0;
	}
</style>
