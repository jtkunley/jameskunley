---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout
	title="Writing"
	description="Technical writing on software architecture, complex systems, and engineering practice."
	noindex={posts.length === 0}
>
	<div class="container container--narrow">
		<header class="page-header">
			<p class="label">Writing</p>
			<h1>Notes on building software</h1>
			<p>Essays and technical notes on architecture, systems, and the practice of engineering.{posts.length > 0 && <> Also available via <a href="/rss.xml">RSS</a>.</>}</p>
		</header>
		{posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">Nothing published yet.</p>}
	</div>
</BaseLayout>
