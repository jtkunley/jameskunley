---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getProjects } from '../lib/content';
import { EXPERTISE, LINKS, PROFILE, SITE } from '../site.config';

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const recentPosts = (await getPosts()).slice(0, 3);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE.name,
	jobTitle: PROFILE.role,
	url: SITE.url,
	email: `mailto:${LINKS.email}`,
	sameAs: [LINKS.github, LINKS.linkedin],
};
---

<BaseLayout>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />

	<section class="hero container" aria-labelledby="intro-heading">
		<div class="hero-text">
			<p class="eyebrow">{PROFILE.role} · {PROFILE.location}</p>
			<h1 id="intro-heading">{PROFILE.tagline}</h1>
			<div class="intro">
				{PROFILE.intro.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			<div class="actions">
				<a class="button button--primary" href={PROFILE.resume}>Download resume</a>
				<a class="button" href={`mailto:${LINKS.email}`}>Get in touch</a>
			</div>
			<SocialLinks />
		</div>
		<figure class="hero-photo">
			<Image
				src={profilePhoto}
				alt={PROFILE.photoAlt}
				widths={[320, 480, 640]}
				sizes="(min-width: 56rem) 20rem, 60vw"
				loading="eager"
				fetchpriority="high"
			/>
			<figcaption><span class="status-dot" aria-hidden="true"></span>{PROFILE.availability}</figcaption>
		</figure>
	</section>

	<section class="section container" aria-labelledby="expertise-heading">
		<div class="section-head">
			<p class="eyebrow">What I do</p>
			<h2 id="expertise-heading">Engineering expertise</h2>
		</div>
		<div class="expertise">
			{
				EXPERTISE.map(({ area, detail, skills }) => (
					<div class="area">
						<h3>{area}</h3>
						<p class="muted">{detail}</p>
						<ul class="tag-list" aria-label={`${area} skills`}>
							{skills.map((s) => <li>{s}</li>)}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="section container" aria-labelledby="projects-heading">
		<div class="section-head">
			<p class="eyebrow">Selected work</p>
			<h2 id="projects-heading">Projects</h2>
			<a class="more" href="/projects/">All projects <span aria-hidden="true">→</span></a>
		</div>
		<ul class="grid">
			{
				featured.map((project) => (
					<li>
						<ProjectCard project={project} />
					</li>
				))
			}
		</ul>
	</section>

	{
		recentPosts.length > 0 && (
			<section class="section container" aria-labelledby="writing-heading">
				<div class="section-head">
					<p class="eyebrow">Notes & essays</p>
					<h2 id="writing-heading">Recent writing</h2>
					<a class="more" href="/blog/">
						All posts <span aria-hidden="true">→</span>
					</a>
				</div>
				<PostList posts={recentPosts} headingLevel="h3" />
			</section>
		)
	}
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.5rem;
		align-items: center;
		padding-block: clamp(3rem, 9vw, 6rem);
	}
	@media (min-width: 56rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) 20rem;
			gap: 4rem;
		}
	}
	.hero h1 {
		max-width: 18ch;
		margin-bottom: 1.5rem;
	}
	.intro {
		max-width: var(--measure);
		font-size: var(--step-1);
		color: var(--color-muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2rem 0 1.75rem;
	}
	.hero-photo {
		margin: 0;
		max-width: 20rem;
	}
	.hero-photo img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
	}
	figcaption {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-top: 0.75rem;
		font-size: var(--step--1);
		color: var(--color-muted);
	}
	.status-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #2f8f57;
	}

	.section {
		padding-block: clamp(2.5rem, 6vw, 4rem);
		border-top: 1px solid var(--color-rule);
	}
	.section-head {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		column-gap: 1rem;
		margin-bottom: 2rem;
	}
	.section-head .eyebrow {
		grid-column: 1 / -1;
	}
	.section-head h2 {
		margin: 0;
	}
	.more {
		font-size: var(--step--1);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	.expertise {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 2.5rem;
	}
	.area h3 {
		font-size: var(--step-1);
		font-weight: 600;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
