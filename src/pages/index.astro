---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import PostList from '../components/PostList.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/content';
import {
	BACKGROUND,
	CONTACT,
	EXPERTISE,
	IMPACT,
	type Icon,
	LINKS,
	PHILOSOPHY,
	PROFILE,
	SITE,
} from '../site.config';

const recentPosts = (await getPosts()).slice(0, 3);

const visible = {
	expertise: EXPERTISE.length > 0,
	impact: IMPACT.length > 0,
	philosophy: PHILOSOPHY.statement !== '',
	background: BACKGROUND.summary !== '',
	writing: recentPosts.length > 0,
	connect: true,
};
const shown = Object.entries(visible)
	.filter(([, isVisible]) => isVisible)
	.map(([id]) => id);
const indexOf = (id: keyof typeof visible) => String(shown.indexOf(id) + 1).padStart(2, '0');

const icons: Record<Icon, string[]> = {
	architecture: [
		'M9 3h6v5H9z',
		'M3 16h6v5H3z',
		'M15 16h6v5h-6z',
		'M12 8v4M6 16v-4h12v4',
	],
	performance: ['M3 12h4l3-8 4 16 3-8h4'],
	realtime: [
		'M3 12a9 9 0 0 1 15.36-6.36L21 8',
		'M21 3v5h-5',
		'M21 12a9 9 0 0 1-15.36 6.36L3 16',
		'M8 16H3v5',
	],
};

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE.name,
	jobTitle: PROFILE.role,
	url: SITE.url,
	email: `mailto:${LINKS.email}`,
	sameAs: [LINKS.github, LINKS.linkedin],
	knowsAbout: PROFILE.specialties,
	address: { '@type': 'PostalAddress', addressLocality: 'Vancouver', addressRegion: 'WA' },
};
---

<BaseLayout>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />

	<section class="hero container" aria-labelledby="hero-name">
		<div class="hero-text">
			<p class="label">{PROFILE.role} · {PROFILE.location}</p>
			<h1 id="hero-name" class="name">{PROFILE.name}</h1>
			{PROFILE.statement && <p class="statement">{PROFILE.statement}</p>}
			{PROFILE.intro && <p class="intro">{PROFILE.intro}</p>}
			{
				PROFILE.specialties.length > 0 && (
					<ul class="dotted specialties" aria-label="Specializations">
						{PROFILE.specialties.map((s) => (
							<li>{s}</li>
						))}
					</ul>
				)
			}
		</div>
		<div class="hero-photo">
			<Image
				src={profilePhoto}
				alt={PROFILE.photoAlt}
				widths={[400, 600, 800, 1000]}
				sizes="(min-width: 60rem) 26rem, 90vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</section>

	{
		visible.expertise && (
			<Section id="expertise" index={indexOf('expertise')} title="Expertise">
				<ul class="expertise">
					{EXPERTISE.map(({ title, icon, points }) => (
						<li>
							<svg
								class="icon"
								viewBox="0 0 24 24"
								width="28"
								height="28"
								aria-hidden="true"
								focusable="false"
							>
								{icons[icon].map((d) => (
									<path d={d} />
								))}
							</svg>
							<h3>{title}</h3>
							<ul class="points">
								{points.map((point) => (
									<li>{point}</li>
								))}
							</ul>
						</li>
					))}
				</ul>
			</Section>
		)
	}

	{
		visible.impact && (
			<Section id="impact" index={indexOf('impact')} title="Selected impact">
				<ul class="impact">
					{IMPACT.map(({ title, summary }) => (
						<li>
							<h3>{title}</h3>
							<p>{summary}</p>
						</li>
					))}
				</ul>
			</Section>
		)
	}

	{
		visible.philosophy && (
			<div class="band">
				<Section id="philosophy" index={indexOf('philosophy')} title="Philosophy">
					<blockquote class="philosophy">
						<p class="philosophy-statement">{PHILOSOPHY.statement}</p>
						{PHILOSOPHY.body.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</blockquote>
				</Section>
			</div>
		)
	}

	{
		visible.background && (
			<Section id="background" index={indexOf('background')} title="Background">
				<p class="background-summary">{BACKGROUND.summary}</p>
				{BACKGROUND.companies.length > 0 && (
					<div class="companies">
						<p class="label">Including work at</p>
						<ul class="dotted">
							{BACKGROUND.companies.map((company) => (
								<li>{company}</li>
							))}
						</ul>
					</div>
				)}
			</Section>
		)
	}

	{
		visible.writing && (
			<Section id="writing" index={indexOf('writing')} title="Writing" more={{ href: '/blog/', label: 'All writing' }}>
				<PostList posts={recentPosts} headingLevel="h3" compact />
			</Section>
		)
	}

	<Section id="connect" index={indexOf('connect')} title="Connect">
		<dl class="contact">
			{
				CONTACT.map(({ label, value, href }) => (
					<div>
						<dt>{label}</dt>
						<dd>
							<a href={href}>{value}</a>
						</dd>
					</div>
				))
			}
		</dl>
	</Section>
</BaseLayout>

<style>
	/* Hero */
	.hero {
		display: grid;
		gap: 3rem;
		padding-block: clamp(2.5rem, 7vw, 6rem) clamp(4rem, 10vw, 7.5rem);
	}
	@media (min-width: 60rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) clamp(18rem, 32vw, 26rem);
			gap: clamp(3rem, 6vw, 6rem);
			align-items: end;
		}
	}
	.hero-photo {
		max-width: 26rem;
	}
	@media (max-width: 59.99rem) {
		.hero-photo {
			order: -1;
			max-width: min(15rem, 60vw);
		}
	}
	.hero-photo img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
		background: var(--color-surface);
	}
	.name {
		font-size: var(--step-5);
		line-height: 1;
		letter-spacing: -0.03em;
		margin: 0 0 2rem;
	}
	.statement {
		font-family: var(--font-display);
		font-size: var(--step-3);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-text);
		max-width: 22ch;
		margin: 0 0 1.75rem;
		text-wrap: balance;
	}
	.intro {
		max-width: 34rem;
		font-size: var(--step-1);
		color: var(--color-muted);
		margin: 0 0 2rem;
	}

	/* Inline list separated by small accent dots */
	.dotted {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.9rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.dotted li {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
	}
	.dotted li + li::before {
		content: '';
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--color-accent);
	}
	.specialties {
		font-size: var(--step--1);
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--color-text);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-text,
		.hero-photo {
			animation: rise 0.9s var(--ease) both;
		}
		.hero-photo {
			animation-delay: 0.1s;
		}
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	/* Expertise */
	.expertise {
		display: grid;
		gap: 2.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.expertise > li {
		padding-top: 1.75rem;
		border-top: 1px solid var(--color-rule);
	}
	/* Three columns only when they fit; otherwise balanced rows rather than a 2 + 1 wrap. */
	@media (min-width: 40rem) and (max-width: 79.99rem) {
		.expertise > li {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
			grid-template-areas: 'icon points' 'title points';
			grid-template-rows: auto 1fr;
			column-gap: 2.5rem;
		}
		.expertise .icon {
			grid-area: icon;
		}
		.expertise h3 {
			grid-area: title;
		}
		.expertise .points {
			grid-area: points;
		}
	}
	@media (min-width: 80rem) {
		.expertise {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.icon {
		display: block;
		margin-bottom: 1.25rem;
		fill: none;
		stroke: var(--color-accent);
		stroke-width: 1.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.expertise h3 {
		font-size: var(--step-1);
		font-weight: 500;
		margin: 0 0 1rem;
	}
	.points {
		list-style: none;
		margin: 0;
		padding: 0;
		color: var(--color-muted);
		line-height: 1.45;
	}
	.points li + li {
		margin-top: 0.8rem;
	}

	/* Impact */
	.impact {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-rule);
	}
	.impact li {
		display: grid;
		gap: 0.5rem 3rem;
		padding-block: 2rem;
		border-bottom: 1px solid var(--color-rule);
	}
	@media (min-width: 48rem) {
		.impact li {
			grid-template-columns: 15rem minmax(0, 1fr);
			align-items: baseline;
		}
	}
	.impact h3 {
		font-size: var(--step-2);
		margin: 0;
	}
	.impact p {
		margin: 0;
		max-width: 36rem;
		color: var(--color-muted);
	}

	/* Philosophy */
	.band {
		background: var(--color-surface);
		border-block: 1px solid var(--color-rule);
	}
	.philosophy {
		margin: 0;
		max-width: 40rem;
	}
	.philosophy-statement {
		font-family: var(--font-display);
		font-size: var(--step-4);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
		max-width: 20ch;
		margin: 0 0 2rem;
		text-wrap: balance;
	}
	.philosophy p:not(.philosophy-statement) {
		font-size: var(--step-1);
		color: var(--color-muted);
		margin: 0 0 1rem;
	}

	/* Background */
	.background-summary {
		font-family: var(--font-display);
		font-size: var(--step-2);
		line-height: 1.3;
		color: var(--color-text);
		max-width: 30ch;
		margin: 0 0 2.5rem;
		text-wrap: balance;
	}
	.companies {
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-rule);
	}
	.companies .label {
		margin-bottom: 0.75rem;
	}
	.companies .dotted {
		font-size: var(--step-1);
		color: var(--color-soft);
	}

	/* Connect */
	.contact {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
		gap: 2rem;
		margin: 0;
	}
	.contact div {
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-rule);
	}
	dt {
		font-size: var(--step--1);
		color: var(--color-muted);
		margin-bottom: 0.35rem;
	}
	dd {
		margin: 0;
	}
	dd a {
		text-decoration-color: transparent;
	}
	dd a:hover {
		text-decoration-color: currentColor;
	}
</style>
