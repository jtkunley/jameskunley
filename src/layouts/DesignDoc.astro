---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { designPdfPath } from '../lib/pdf/paths';
import { PROFILE, SITE } from '../site.config';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'designs'>['data'] & { slug: string };

const { slug, title, description, pubDate, updatedDate, tags, heroImage, heroImageAlt } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const displayURL = `${canonicalURL.host}${canonicalURL.pathname}`;

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: PROFILE.name, url: SITE.url },
	mainEntityOfPage: canonicalURL.href,
};
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage}
	imageAlt={heroImage ? heroImageAlt : undefined}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

	<article class="container container--doc">
		<header class="page-header">
			<p class="label">
				<a class="crumb" href="/designs/">Designs</a> · <FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1>{title}</h1>
			<p class="print-only byline">
				By {PROFILE.name} · <a href={canonicalURL.href}>{displayURL}</a>
			</p>
			<p>{description}</p>
			{
				tags.length > 0 && (
					<ul class="inline-list" aria-label="Tags">
						{tags.map((tag) => (
							<li>
								<a class="tag" href={`/designs/tags/${tag}/`}>#{tag}</a>
							</li>
						))}
					</ul>
				)
			}
			<p class="export">
				<a class="export-link" href={designPdfPath(slug)} download>
					Export to PDF <span aria-hidden="true">↓</span>
				</a>
			</p>
		</header>
		{
			heroImage && (
				<Image class="hero" src={heroImage} alt={heroImageAlt} width={1280} loading="eager" />
			)
		}
		<div class="prose">
			<slot />
		</div>
		<p class="print-only colophon">
			© {pubDate.getFullYear()} {PROFILE.name}. All rights reserved. Latest version:{' '}
			<a href={canonicalURL.href}>{displayURL}</a>
		</p>
		<footer class="article-footer">
			<a class="more" href="/designs/"><span aria-hidden="true">←</span> All designs</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: 3rem;
		border-bottom: 1px solid var(--color-rule);
	}
	.export {
		margin: 1.75rem 0 0;
	}
	.export-link {
		display: inline-flex;
		gap: 0.5em;
		padding: 0.5em 1em;
		font-size: var(--step--1);
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--color-text);
		text-decoration: none;
		border: 1px solid var(--color-rule-strong);
		border-radius: var(--radius);
		transition:
			color 0.2s var(--ease),
			border-color 0.2s var(--ease);
	}
	.export-link:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
	.print-only {
		display: none;
	}
	@media print {
		.export,
		.article-footer {
			display: none;
		}
		.print-only {
			display: block;
		}
		.byline {
			margin: -0.5rem 0 1rem;
			font-size: 10pt;
			color: var(--color-text);
		}
		.colophon {
			margin-top: 1.5rem;
			padding-top: 0.75rem;
			border-top: 1px solid var(--color-rule);
			font-size: 8.5pt;
			color: var(--color-muted);
			break-before: avoid;
			break-inside: avoid;
		}
	}
	.hero {
		width: 100%;
		margin-bottom: 3rem;
		border-radius: var(--radius);
	}
	.article-footer {
		margin-top: 5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-rule);
	}
</style>
