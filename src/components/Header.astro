---
import { NAV, PROFILE } from '../site.config';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="container inner">
		<a class="brand" href="/">{PROFILE.name}</a>
		<nav aria-label="Main">
			<ul>
				{
					NAV.map(({ href, label }) => (
						<li>
							<HeaderLink href={href}>{label}</HeaderLink>
						</li>
					))
				}
				<li><a class="resume" href={PROFILE.resume}>Resume</a></li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-rule);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1.1rem;
	}
	.brand {
		font-family: var(--font-display);
		font-size: var(--step-1);
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: var(--step--1);
		font-weight: 500;
	}
	a {
		color: var(--color-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--color-text);
	}
	.resume {
		color: var(--color-accent);
	}
</style>
