---
import { LINKS } from '../site.config';

const links = [
	{
		label: 'GitHub',
		href: LINKS.github,
		icon: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
	},
	{
		label: 'LinkedIn',
		href: LINKS.linkedin,
		icon: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
	},
	{
		label: 'Email',
		href: `mailto:${LINKS.email}`,
		icon: 'M2 4h20a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v.4l10 6.25L22 6.4V6H2Zm20 2.76-9.47 5.92a1 1 0 0 1-1.06 0L2 8.76V18h20V8.76Z',
	},
];
---

<ul class="social">
	{
		links.map(({ label, href, icon }) => (
			<li>
				<a href={href} rel={href.startsWith('http') ? 'me noopener' : undefined}>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
						<path d={icon} fill="currentColor" />
					</svg>
					<span>{label}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		color: var(--color-muted);
		text-decoration: none;
		font-size: var(--step--1);
		font-weight: 500;
	}
	a:hover {
		color: var(--color-text);
	}
</style>
