---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import defaultImage from '../assets/og-default.jpg';
import { getPosts } from '../lib/content';
import { LINKS, PROFILE, SITE } from '../site.config';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
}

const {
	title,
	description = SITE.description,
	image = defaultImage,
	imageAlt = `${PROFILE.name}, ${PROFILE.role}`,
	type = 'website',
	publishedTime,
	modifiedTime,
	noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${PROFILE.role}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const ogImageURL = new URL(ogImage.src, Astro.site);
const hasPosts = (await getPosts()).length > 0;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={PROFILE.name} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
<meta name="theme-color" content="#151413" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{hasPosts && <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · Writing`} href="/rss.xml" />}
<link rel="me" href={LINKS.github} />
<link rel="me" href={LINKS.linkedin} />

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale.replace('-', '_')} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title ?? pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogImage.attributes.width)} />
<meta property="og:image:height" content={String(ogImage.attributes.height)} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<slot />
